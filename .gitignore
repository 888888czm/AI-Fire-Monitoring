#============================================================
# LifeGuard Monitor - .gitignore
#============================================================
# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
# 虚拟环境
venv/
.venv/
env/
ENV/
.python-version
# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
# ---------- PyInstaller 打包产物----------
*.spec
*.manifest
*.exe
*.msi
*.dmg
*.pkg
*.app/
*.appimage
*.AppImage
# 若确实需要保留打包配置，请手动添加：
# !lifeguard_monitor.spec
# ---------- 运行时数据（重要：可能含隐私与密钥）----------
# 程序生成的抓拍图片、报告、日志
snapshots/
reports/
LifeGuardData/
*.jpg
*.jpeg
*.png
*.bmp
*.mp4
*.avi
*.mkv
# Server酱 SendKey 等本地凭据
sendkey.txt
*.key
*.secret
secrets.json
config.local.*
.env
.env.*
# 应用日志
*.log
logs/
# ---------- 操作系统 ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
*.code-workspace
# ---------- 其他 ----------
*.tmp
*.temp
*.bak
*.orig
*.rej
.cache/
node_modules/
